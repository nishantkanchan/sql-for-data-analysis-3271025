{
  "expo": {
    "name": "Shloka Setu",
    "slug": "shloka-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shlokasetu",
    "userInterfaceStyle": "automatic",
    "description": "Read, understand and memorise Caraka, Suśruta and Aṣṭāṅgahṛdaya shlokas in English and Hindi. Offline-first study companion for BAMS students.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.shlokasetu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Shloka Setu uses the camera to photograph a shloka from your textbook so it can be read and explained.",
        "NSPhotoLibraryUsageDescription": "Shloka Setu opens your photos so you can pick a picture of a shloka to be read and explained."
      }
    },
    "android": {
      "package": "in.shlokasetu.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2B2870",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Shloka Setu",
      "shortName": "Shloka Setu",
      "themeColor": "#2B2870",
      "backgroundColor": "#F6F0E2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#13112A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shloka Setu opens your photos so you can pick a picture of a shloka to be read and explained.",
          "cameraPermission": "Shloka Setu uses the camera to photograph a shloka from your textbook so it can be read and explained.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
