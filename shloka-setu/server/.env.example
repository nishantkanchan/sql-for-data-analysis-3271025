# --- Server ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info                 # debug | info | warn | error | silent

# --- Claude ---
# Leave empty to run in MOCK MODE: search, verse and curated explain work fully;
# scan and tutor return clearly flagged demo output ("mock": true).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5   # cheaper: claude-sonnet-5-5 (~1/2 cost) or claude-haiku-5-5 (~1/40 cost)
ANTHROPIC_EFFORT_OCR=low          # low | medium | high | xhigh | max
ANTHROPIC_EFFORT_EXPLAIN=medium
ANTHROPIC_EFFORT_TUTOR=low
ANTHROPIC_TIMEOUT_MS=90000
ANTHROPIC_MAX_RETRIES=2           # SDK retries 408/409/429/5xx with backoff
ANTHROPIC_FALLBACKS=true          # server-side refusal fallback (fallbacks:"default"), only sent for models that support it
MOCK_MODE=false                   # force mock mode even with a key

# --- Content ---
# Defaults to ../content/data relative to the server folder.
# CONTENT_DIR=/app/content/data
CONTENT_RELOAD_SECONDS=60         # re-scan content files every N s and reload if changed (0 = off)
MATCH_STRONG_THRESHOLD=0.65       # search score above which /v1/explain serves curated content with no LLM call

# --- HTTP ---
CORS_ORIGINS=*                    # or a comma list: https://app.example.com,http://localhost:8081
TRUST_PROXY=false                 # true behind Render/Railway/Fly/Cloud Run/nginx so X-Forwarded-For is used for rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120                # all /v1 requests per IP per window (0 = off)
RATE_LIMIT_AI_MAX=12              # /v1/scan, /v1/explain, /v1/tutor per IP per window (0 = off)
JSON_BODY_LIMIT_BYTES=262144
MAX_IMAGE_BYTES=5242880           # decoded image size limit for /v1/scan
TUTOR_MAX_HISTORY=12              # messages kept from the conversation
