{
  "name": "shloka-setu",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/tiro-devanagari-sanskrit": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
